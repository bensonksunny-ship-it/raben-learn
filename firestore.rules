rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function hasRole(role) { return isSignedIn() && role in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles; }
    function isAdminOrMentor() { return hasRole('admin') || hasRole('mentor'); }
    // Academic Consultant — syllabus edit rights only, nothing else `isAdminOrMentor()`
    // gates (student_lesson_progress/student_daily_plans delete, course_history
    // create, mentor_centres) is meant to widen to this role, so it's its own
    // function rather than folded into that one.
    function canEditSyllabus() { return isAdminOrMentor() || hasRole('consultant'); }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function targetIsElevated(uid) {
      let roles = get(/databases/$(database)/documents/users/$(uid)).data.roles;
      return ('admin' in roles) || ('manager' in roles);
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstLogin', 'name']);
      allow create, update, delete: if hasRole('admin');
      // Manager: may edit a non-elevated user's course assignment directly from the client
      // (StudentsPage's one direct Firestore write), but never roles/status, and never an
      // admin/manager account. Everything else for a manager goes through the Cloud Functions,
      // which run on the Admin SDK and aren't subject to these rules at all.
      allow update: if hasRole('manager')
        && !targetIsElevated(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['courseIds', 'courseId']);
    }

    match /courses/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if canEditSyllabus();
    }
    match /sessions/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if canEditSyllabus();
    }

    // A `match` on a collection doesn't cover its subcollections — exam papers
    // live under `courses/{courseId}/exams/{examId}`, with their sections and
    // questions embedded in the one doc, but still need their own rule here or
    // every read/write to them is denied by default. Admin/mentor-only to
    // write (the Exam button in the Syllabus Builder is gated the same way, not
    // widened to `canEditSyllabus()`'s consultant role) but readable by anyone
    // signed in, since a student needs the exam doc (including each question's
    // options/correctAnswer) to take an mcq exam client-side — same tradeoff the
    // old questionBank rule made; there's no server-side grading to hide it behind.
    match /courses/{courseId}/exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrMentor();
    }

    // Reusable sub-section designs (title/caption/marks), global across courses —
    // built once from the Exam Manager's section picker and reused on later exam
    // papers there. Same access shape as the exam docs themselves.
    match /sectionTemplates/{id} {
      allow read: if isSignedIn();
      allow write: if isAdminOrMentor();
    }

    match /student_lesson_progress/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrMentor();
    }

    match /student_daily_plans/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrMentor() || (isSignedIn() && id.matches(request.auth.uid + '_.*'));
    }

    // A student's own exam attempt: created when they start an exam (ExamInstructions),
    // updated as they answer and submit (ExamRunner) — both scoped to the attempt's
    // own `studentId` matching the caller, same ownership shape as `isOwner()` above.
    // Read stays blanket `isSignedIn()`, matching `student_lesson_progress`/
    // `student_daily_plans` below: admin/mentor's Results tab reads every attempt
    // for a course, not just one student's own.
    match /examAttempts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }

    // Live Class attendance — one doc per student per day (id: "{studentId}_{date}").
    // A scan writes through whatever signed-in device holds the card (the
    // student's own account on their phone, or a staff kiosk) — but only once
    // the submitted `qrToken` matches *that* student's own stored token, so a
    // scan can only ever mark the card that was actually scanned. Staff can
    // also write directly (no token), for manual corrections from the Live
    // Class roster.
    match /attendance/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrMentor() || hasRole('manager')
        || (isSignedIn()
            && request.resource.data.studentId is string
            && request.resource.data.qrToken == get(/databases/$(database)/documents/users/$(request.resource.data.studentId)).data.qrToken);
    }

    match /course_history/{id} {
      allow read: if isSignedIn();
      allow create: if isAdminOrMentor();
      allow delete: if hasRole('admin');
    }

    match /planning_levels/{id} {
      allow read, write: if hasRole('admin');
    }

    match /planning_subjects/{id} {
      allow read, write: if hasRole('admin');
    }

    // Shared, platform-wide weekly class timetable — manager-authored, readable by
    // everyone signed in so a later pass can surface it to students/mentors. Admin
    // can write too: rbac.ts's `manageTimetable` capability already lets admin reach
    // /schedule in the UI, and in practice admin is the only account most people have.
    // `student` can write too — their own Timetable view's "Today" grid lets them
    // click an empty slot to add a class directly into this same shared doc.
    match /class_timetable/{id} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin') || hasRole('student');
    }

    // Priority-2 elective-session board, layered over class_timetable on the same
    // scheduler grid — same access pattern (and same admin/student exception) as
    // the locked timetable above.
    match /elective_sessions/{id} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin') || hasRole('student');
    }

    // Per-student schedule overrides — doc id is the student's own uid. Same
    // shape as class_timetable/elective_sessions (ClassTimetable/ElectiveSchedule),
    // but only ever read/written for one specific student rather than shared.
    // Staff manage these from the Schedule page's student picker; a student can
    // also write their own once it exists, from StudentTimetableView's own
    // self-booking flow (same exception class_timetable grants every student,
    // scoped down to just their own doc here since this one isn't shared).
    match /student_timetables/{studentId} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin') || isOwner(studentId);
    }
    match /student_electives/{studentId} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin') || isOwner(studentId);
    }

    // Custom non-subject activity categories (Lunch, Assembly, Travel, …) offered
    // alongside syllabus subjects in the period/elective title dropdown — managed
    // from the Schedule page's "Manage Activity Types" panel. Readable by anyone
    // signed in (students/mentors see the same colored cards on the grid), but
    // only manager/admin define the categories themselves — narrower than
    // `class_timetable`'s student exception, since this is an org-wide setting,
    // not a specific booking.
    match /activity_types/{id} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin');
    }

    // Live Class kiosk link's secret token (`settings/liveClassKiosk`, field
    // `token`) — generated/rotated from the Schedule page, same role shape as
    // `class_timetable`/`elective_sessions` above (manager reaches /schedule
    // too, not just admin). The kiosk link itself never reads this doc
    // directly — the `resolveLiveClassKiosk` Cloud Function checks it with the
    // Admin SDK (which bypasses these rules entirely) before minting anything.
    match /settings/{id} {
      allow read, write: if isAdminOrMentor() || hasRole('manager');
    }

    // Legacy collections for Cloud Functions
    match /centres/{id} { allow read, write: if hasRole('admin'); }
    match /mentor_centres/{id} { allow read, write: if isAdminOrMentor(); }
    match /students/{id} { allow read, write: if isSignedIn(); }
  }
}
