rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function hasRole(role) { return isSignedIn() && role in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles; }
    function isAdminOrMentor() { return hasRole('admin') || hasRole('mentor'); }
    // Academic Consultant — syllabus edit rights only, nothing else `isAdminOrMentor()`
    // gates (student_lesson_progress/student_daily_plans delete, course_history
    // create, mentor_centres) is meant to widen to this role, so it's its own
    // function rather than folded into that one.
    function canEditSyllabus() { return isAdminOrMentor() || hasRole('consultant'); }
    // Matches rbac.ts's `scheduleExams` capability (admin, mentor, manager, consultant).
    function canScheduleExams() { return isAdminOrMentor() || hasRole('manager') || hasRole('consultant'); }
    // Lesson notes are stricter than the rest of the syllabus: mentor ("teacher")
    // is deliberately read-only here, unlike canEditSyllabus() above.
    function canEditLessonNotes() { return hasRole('admin') || hasRole('consultant'); }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function targetIsElevated(uid) {
      let roles = get(/databases/$(database)/documents/users/$(uid)).data.roles;
      return ('admin' in roles) || ('manager' in roles) || ('founder' in roles);
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstLogin', 'name']);
      allow create, update, delete: if hasRole('admin');
      // Manager: may edit a non-elevated user's course assignment and Top Tier flag
      // directly from the client (StudentsPage's direct Firestore writes), but never
      // roles/status, and never an admin/manager account. Everything else for a
      // manager goes through the Cloud Functions, which run on the Admin SDK and
      // aren't subject to these rules at all.
      allow update: if hasRole('manager')
        && !targetIsElevated(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['courseIds', 'courseId', 'isTopTier']);
    }

    match /courses/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if canEditSyllabus();
    }
    match /sessions/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if canEditSyllabus();
    }

    // A `match` on a collection doesn't cover its subcollections — exam papers
    // live under `courses/{courseId}/exams/{examId}`, with their sections and
    // questions embedded in the one doc, but still need their own rule here or
    // every read/write to them is denied by default. Write access matches
    // `canEditSyllabus()` (admin/mentor/consultant — the Exam button in the
    // Syllabus Builder is gated the same way) but readable by anyone signed in,
    // since a student needs the exam doc (including each question's
    // options/correctAnswer) to take an mcq exam client-side — same tradeoff the
    // old questionBank rule made; there's no server-side grading to hide it behind.
    match /courses/{courseId}/exams/{examId} {
      allow read: if isSignedIn();
      allow write: if canEditSyllabus();
    }

    // Reusable sub-section designs (title/caption/marks), global across courses —
    // built once from the Exam Manager's section picker and reused on later exam
    // papers there. Same access shape as the exam docs themselves.
    match /sectionTemplates/{id} {
      allow read: if isSignedIn();
      allow write: if canEditSyllabus();
    }

    // Lesson notes — one doc per syllabus topic (topicId as the doc id).
    // Readable by any signed-in user (mentor/"teacher" views + downloads them),
    // writable only by admin/consultant — see canEditLessonNotes().
    match /topic_notes/{topicId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canEditLessonNotes();
    }

    // Dated exam bookings (ExamSchedulePage's "+ Schedule exam") — one doc per
    // sitting, shown on every timetable view, the students' Exams page, and the
    // Live Class kiosk. Read stays open since students need it to know when
    // their own papers are live; write matches `canScheduleExams()` above.
    match /exam_schedules/{id} {
      allow read: if isSignedIn();
      allow write: if canScheduleExams();
    }

    // Both collections key their docs "{studentId}_{...}" — a student may only
    // write a doc whose id and `studentId` field are their own; admin/mentor
    // (review, approve, mark due) may write anyone's.
    function ownsStudentDoc(id) {
      return isSignedIn()
        && id.matches(request.auth.uid + '_.*')
        && request.resource.data.studentId == request.auth.uid;
    }

    match /student_lesson_progress/{id} {
      allow read: if isSignedIn();
      allow create, update: if ownsStudentDoc(id) || isAdminOrMentor();
      allow delete: if isAdminOrMentor();
    }

    match /student_daily_plans/{id} {
      allow read: if isSignedIn();
      allow create, update: if ownsStudentDoc(id) || isAdminOrMentor();
      allow delete: if isAdminOrMentor() || (isSignedIn() && id.matches(request.auth.uid + '_.*'));
    }

    // A student's own exam attempt: created when they start an exam (ExamInstructions),
    // updated as they answer and submit (ExamRunner) — both scoped to the attempt's
    // own `studentId` matching the caller, same ownership shape as `isOwner()` above.
    // Read stays blanket `isSignedIn()`, matching `student_lesson_progress`/
    // `student_daily_plans` below: admin/mentor's Results tab reads every attempt
    // for a course, not just one student's own.
    match /examAttempts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }

    // Live Class attendance — one doc per student per day (id: "{studentId}_{date}").
    // A scan writes through whatever signed-in device holds the card (the
    // student's own account on their phone, or a staff kiosk) — but only once
    // the submitted `qrToken` matches *that* student's own stored token, so a
    // scan can only ever mark the card that was actually scanned. Staff can
    // also write directly (no token), for manual corrections from the Live
    // Class roster.
    match /attendance/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrMentor() || hasRole('manager')
        || (isSignedIn()
            && request.resource.data.studentId is string
            && request.resource.data.qrToken == get(/databases/$(database)/documents/users/$(request.resource.data.studentId)).data.qrToken);
    }

    match /course_history/{id} {
      allow read: if isSignedIn();
      allow create: if isAdminOrMentor();
      allow delete: if hasRole('admin');
    }

    match /planning_levels/{id} {
      allow read, write: if hasRole('admin');
    }

    match /planning_subjects/{id} {
      allow read, write: if hasRole('admin');
    }

    // Shared, platform-wide weekly class timetable — manager-authored, readable by
    // everyone signed in so a later pass can surface it to students/mentors. Admin
    // can write too: rbac.ts's `manageTimetable` capability already lets admin reach
    // /schedule in the UI, and in practice admin is the only account most people have.
    // `student` can write too — their own Timetable view's "Today" grid lets them
    // click an empty slot to add a class directly into this same shared doc.
    match /class_timetable/{id} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin') || hasRole('student');
    }

    // Priority-2 elective-session board, layered over class_timetable on the same
    // scheduler grid — same access pattern (and same admin/student exception) as
    // the locked timetable above.
    match /elective_sessions/{id} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin') || hasRole('student');
    }

    // Per-student schedule overrides — doc id is the student's own uid. Same
    // shape as class_timetable/elective_sessions (ClassTimetable/ElectiveSchedule),
    // but only ever read/written for one specific student rather than shared.
    // Staff manage these from the Schedule page's student picker; a student can
    // also write their own once it exists, from StudentTimetableView's own
    // self-booking flow (same exception class_timetable grants every student,
    // scoped down to just their own doc here since this one isn't shared).
    match /student_timetables/{studentId} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin') || isOwner(studentId);
    }
    match /student_electives/{studentId} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin') || isOwner(studentId);
    }

    // Custom non-subject activity categories (Lunch, Assembly, Travel, …) offered
    // alongside syllabus subjects in the period/elective title dropdown — managed
    // from the Schedule page's "Manage Activity Types" panel. Readable by anyone
    // signed in (students/mentors see the same colored cards on the grid), but
    // only manager/admin define the categories themselves — narrower than
    // `class_timetable`'s student exception, since this is an org-wide setting,
    // not a specific booking.
    match /activity_types/{id} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin');
    }

    // Places of study (desk/cabin/lab table + seats) — manager-defined from the
    // Schedule page's "Places" panel, same shape as activity_types above.
    match /study_places/{id} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin');
    }
    // One doc per student: which place they use for each subject. Readable by
    // everyone signed in (seat counts are summed client-side across students);
    // written by staff from the Places panel, or by the student's own Timetable
    // view when it auto-fills a subject that has no place yet.
    match /study_place_assignments/{studentId} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin') || isOwner(studentId);
    }

    // Live Class kiosk link's secret token (`settings/liveClassKiosk`, field
    // `token`) — generated/rotated from the Schedule page, same role shape as
    // `class_timetable`/`elective_sessions` above (manager reaches /schedule
    // too, not just admin). The kiosk link itself never reads this doc
    // directly — the `resolveLiveClassKiosk` Cloud Function checks it with the
    // Admin SDK (which bypasses these rules entirely) before minting anything.
    // "Class started" marker for the day (id: YYYY-MM-DD), pressed on the Live
    // Class kiosk TV (signed in via the `liveClassKiosk` custom-token claim) or
    // by staff. Create-only, with a server-stamped `startedAt`, so a second tap
    // can't move the start time later; delete is the kiosk's "Undo".
    match /class_runs/{date} {
      allow read: if isSignedIn();
      allow create: if (request.auth.token.liveClassKiosk == true || isAdminOrMentor() || hasRole('manager'))
        && request.resource.data.keys().hasOnly(['date', 'scheduledStart', 'startedAt'])
        && request.resource.data.date == date
        && request.resource.data.scheduledStart is string
        && request.resource.data.startedAt == request.time;
      allow delete: if request.auth.token.liveClassKiosk == true || isAdminOrMentor() || hasRole('manager');
    }

    // Student application form (id: studentId). The student fills in and submits
    // their own (never approving it, never touching the staff review fields, and
    // locked once approved); admin/manager review, edit, approve or send it back;
    // mentors can read it.
    function canReviewStudents() { return hasRole('admin') || hasRole('manager'); }
    function applicationApproved(sid) {
      return exists(/databases/$(database)/documents/student_applications/$(sid))
        && get(/databases/$(database)/documents/student_applications/$(sid)).data.status == 'approved';
    }
    // A parent filling the application from a no-login link (see
    // `resolveApplicationLink` in Cloud Functions) — that function mints a
    // custom token carrying exactly which application this one link is for,
    // so rules check those claims directly instead of trusting the client.
    function isPublicApplyLink(coll, sid) {
      return isSignedIn() && request.auth.token.publicApplyLink == true
        && request.auth.token.coll == coll && request.auth.token.studentId == sid;
    }
    match /student_applications/{sid} {
      allow read: if isOwner(sid) || isAdminOrMentor() || hasRole('manager') || isPublicApplyLink('student_applications', sid);
      allow create, update: if canReviewStudents();
      allow create: if (isOwner(sid) || isPublicApplyLink('student_applications', sid))
        && request.resource.data.studentId == sid
        && request.resource.data.status in ['draft', 'submitted']
        && !request.resource.data.keys().hasAny(['reviewNote', 'reviewedAt', 'reviewedBy', 'studentIdReceived', 'fatherIdReceived', 'motherIdReceived']);
      allow update: if (isOwner(sid) || isPublicApplyLink('student_applications', sid))
        && resource.data.status != 'approved'
        && request.resource.data.studentId == sid
        && request.resource.data.status in ['draft', 'submitted', 'changes_requested']
        && (request.resource.data.status != 'changes_requested' || resource.data.status == 'changes_requested')
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewNote', 'reviewedAt', 'reviewedBy', 'studentIdReceived', 'fatherIdReceived', 'motherIdReceived']);
    }
    // Prospective students from "+ New Student" — same shape as a student
    // application, but no account yet. Staff-only; "Recruit Student" creates the
    // account and copies the application over to `student_applications/{uid}`.
    // Founder reads too — the Founder Overview counts applicants still waiting.
    match /applicants/{id} {
      allow read: if isAdminOrMentor() || hasRole('manager') || hasRole('founder') || isPublicApplyLink('applicants', id);
      allow create, update, delete: if canReviewStudents();
      allow create, update: if isPublicApplyLink('applicants', id)
        && request.resource.data.studentId == id
        && request.resource.data.status in ['draft', 'submitted'];
    }

    // One single-use link per application (id: a random token) — staff generate
    // it directly (see the Students page's "Send link"/"Resend link"), the
    // `resolveApplicationLink`/`completeApplicationLink` Cloud Functions are the
    // only things that ever read or update it afterwards (Admin SDK, bypasses
    // these rules), so no client needs read/write beyond creating a fresh one.
    match /application_links/{token} {
      allow create: if canReviewStudents();
    }

    // Uploaded application documents (photo, ID cards, birth certificate) as
    // compressed data URLs — id "{studentId}__{kind}", one doc per file.
    match /student_application_files/{id} {
      allow read: if (isSignedIn() && id.matches(request.auth.uid + '__.*')) || isAdminOrMentor() || hasRole('manager')
        || (isSignedIn() && request.auth.token.publicApplyLink == true && id.matches(request.auth.token.studentId + '__.*'));
      allow create, update: if request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 1000000
        && id == request.resource.data.studentId + '__' + request.resource.data.kind
        && (canReviewStudents()
            || (isOwner(request.resource.data.studentId) && !applicationApproved(request.resource.data.studentId))
            || (isSignedIn() && request.auth.token.publicApplyLink == true && request.auth.token.studentId == request.resource.data.studentId));
      allow delete: if canReviewStudents()
        || (isSignedIn() && id.matches(request.auth.uid + '__.*') && !applicationApproved(request.auth.uid))
        || (isSignedIn() && request.auth.token.publicApplyLink == true && id.matches(request.auth.token.studentId + '__.*'));
    }

    match /settings/{id} {
      allow read, write: if isAdminOrMentor() || hasRole('manager');
    }

    // Legacy collections for Cloud Functions
    match /centres/{id} { allow read, write: if hasRole('admin'); }
    match /mentor_centres/{id} { allow read, write: if isAdminOrMentor(); }
    // Nothing in the app or the Cloud Functions uses this one any more.
    match /students/{id} { allow read, write: if hasRole('admin'); }
  }
}
