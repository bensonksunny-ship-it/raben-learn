rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function hasRole(role) { return isSignedIn() && role in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles; }
    function isAdminOrMentor() { return hasRole('admin') || hasRole('mentor'); }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function targetIsElevated(uid) {
      let roles = get(/databases/$(database)/documents/users/$(uid)).data.roles;
      return ('admin' in roles) || ('manager' in roles);
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstLogin', 'name']);
      allow create, update, delete: if hasRole('admin');
      // Manager: may edit a non-elevated user's course assignment directly from the client
      // (StudentsPage's one direct Firestore write), but never roles/status, and never an
      // admin/manager account. Everything else for a manager goes through the Cloud Functions,
      // which run on the Admin SDK and aren't subject to these rules at all.
      allow update: if hasRole('manager')
        && !targetIsElevated(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['courseIds', 'courseId']);
    }

    match /courses/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrMentor();
    }
    match /sessions/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrMentor();
    }

    match /student_lesson_progress/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrMentor();
    }

    match /student_daily_plans/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrMentor() || (isSignedIn() && id.matches(request.auth.uid + '_.*'));
    }

    match /course_history/{id} {
      allow read: if isSignedIn();
      allow create: if isAdminOrMentor();
      allow delete: if hasRole('admin');
    }

    match /planning_levels/{id} {
      allow read, write: if hasRole('admin');
    }

    match /planning_subjects/{id} {
      allow read, write: if hasRole('admin');
    }

    // Shared, platform-wide weekly class timetable — manager-authored, readable by
    // everyone signed in so a later pass can surface it to students/mentors. Admin
    // can write too: rbac.ts's `manageTimetable` capability already lets admin reach
    // /schedule in the UI, and in practice admin is the only account most people have.
    // `student` can write too — their own Timetable view's "Today" grid lets them
    // click an empty slot to add a class directly into this same shared doc.
    match /class_timetable/{id} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin') || hasRole('student');
    }

    // Priority-2 elective-session board, layered over class_timetable on the same
    // scheduler grid — same access pattern (and same admin/student exception) as
    // the locked timetable above.
    match /elective_sessions/{id} {
      allow read: if isSignedIn();
      allow write: if hasRole('manager') || hasRole('admin') || hasRole('student');
    }

    // Legacy collections for Cloud Functions
    match /centres/{id} { allow read, write: if hasRole('admin'); }
    match /mentor_centres/{id} { allow read, write: if isAdminOrMentor(); }
    match /students/{id} { allow read, write: if isSignedIn(); }
  }
}
